import matplotlib.pyplot as plt
import numpy as np

def generate_data():
    x = np.linspace(0, 10, 100)
    y = np.sin(x)
    return x, y

def plot_data(x, y):
    fig, ax = plt.subplots()
    ax.plot(x, y)
    ax.set_title("Plot")
    # No display or saving of the plot

def main():
    x, y = generate_data()
    plot_data(x, y)

if __name__ == "__main__":
    main()
